<%# Each card keeps a transform from animate-in-up, so each is its own stacking context and
    later cards paint over this menu unless the open card is raised above them. %>
<div
  class="relative"
  x-data="{ open: false, moving: false }"
  x-effect="if (!open) moving = false; $el.closest('[data-feature-card]')?.classList.toggle('z-30', open)"
>
  <button
    type="button"
    class="<%= button_classes %> absolute top-0 right-0 mt-2 mr-2"
    aria-label="Open menu"
    @click.stop="open = !open"
    @keydown.escape.window="open = false"
  >
    <svg class="size-5 text-stone-500 z-10 dark:text-stone-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
  </button>
  <div
    x-show="open"
    @click.outside="open = false"
    x-transition
    class="absolute right-0 top-full mt-2 mr-2 z-50 bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-700 rounded-lg shadow-lg py-1 focus:outline-none"
    style="display: none;"
    role="menu"
    aria-orientation="vertical"
    aria-label="Dropdown menu"
  >
    <% if move_choices.any? %>
      <button
        type="button"
        class="w-full text-left px-4 py-2 text-sm text-stone-700 hover:bg-stone-50 dark:text-white/80 dark:hover:bg-stone-800 flex items-center gap-2 rounded-md cursor-pointer"
        aria-haspopup="menu"
        x-on:click.stop="moving = !moving"
        role="menuitem">
        Move to…
      </button>
      <div x-show="moving" style="display: none;" role="menu" aria-label="Move to" class="max-h-64 overflow-y-auto border-y border-stone-100 dark:border-white/5">
        <% move_choices.each do |label, folder_id| %>
          <button
            type="button"
            class="w-full text-left pl-8 pr-4 py-1.5 text-sm text-stone-600 hover:bg-stone-50 dark:text-white/70 dark:hover:bg-stone-800 truncate cursor-pointer"
            hx-patch="<%= move_path %>"
            hx-vals="<%= { folder_id: folder_id.to_s }.to_json %>"
            hx-target="closest [data-feature-card]"
            hx-swap="delete"
            role="menuitem"><%= label %></button>
        <% end %>
      </div>
    <% end %>
    <button
      type="button"
      class="w-full text-left px-4 py-2 text-sm text-error-600 hover:bg-error-50 dark:text-error-300 dark:hover:bg-stone-800 flex items-center gap-2 rounded-md focus-visible:ring-3 focus-visible:ring-error-500 cursor-pointer"
      hx-delete="<%= delete_path %>"
      hx-target="<%= delete_target %>"
      hx-swap="outerHTML"
      hx-trigger="confirmed"
      @click.prevent="showConfirmation('<%= escape_javascript(confirmation_message) %>').then(result => { if (result.isConfirmed) { htmx.trigger($el, 'confirmed') } })"
      x-data="{}"
      role="menuitem">
      <%= helpers.delete_icon %>
      Delete
    </button>
  </div>
</div>
