<div data-folder-heading class="mb-4">
  <%= render Folders::BreadcrumbComponent.new(project: project, folder: folder) %>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
    <% if editable? %>
      <div
        class="flex-1 min-w-48"
        x-data="{
          name: <%= folder.name.to_json %>,
          saveName(event) {
            const typed = event.target.innerText.trim();
            if (typed === this.name) return;
            this.name = typed;
            setTimeout(() => htmx.trigger(event.target, 'save-name'), 10);
          }
        }"
      >
        <form id="<%= form_id %>" style="display: none;">
          <input type="hidden" name="folder[name]" x-bind:value="name">
        </form>
        <h2
          class="text-2xl font-bold tracking-tight text-stone-800 dark:text-white/90 is-editable"
          contenteditable="true"
          <%= "autofocus" if focus %>
          <% if focus %>x-init="$nextTick(() => { $el.focus(); getSelection().selectAllChildren($el) })"<% end %>
          x-on:blur="saveName($event)"
          x-on:keydown.enter.prevent="$el.blur()"
          hx-patch="<%= update_path %>"
          hx-trigger="save-name"
          hx-include="#<%= form_id %>"
          hx-target="closest [data-folder-heading]"
          hx-swap="outerHTML"
        ><%= folder.name %></h2>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <div class="relative" x-data="{ open: false }" x-on:keydown.escape.window="open = false">
          <button type="button" class="btn btn-ghost" aria-haspopup="menu" x-on:click="open = !open">Move to…</button>
          <div
            x-show="open"
            x-on:click.outside="open = false"
            x-transition
            style="display: none;"
            role="menu"
            aria-label="Move to"
            class="absolute right-0 top-full mt-2 z-50 min-w-56 max-h-80 overflow-y-auto bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-700 rounded-lg shadow-lg py-1"
          >
            <% move_targets.each do |label, parent_id, depth| %>
              <%= button_to label, update_path,
                    method: :patch,
                    params: { folder: { parent_id: parent_id.to_s } },
                    role: "menuitem",
                    style: "padding-left: #{1 + depth}rem",
                    class: "w-full text-left pr-4 py-2 text-sm text-stone-700 dark:text-white/80 hover:bg-stone-50 dark:hover:bg-stone-800 cursor-pointer truncate" %>
            <% end %>
          </div>
        </div>
        <button
          type="button"
          class="btn btn-ghost text-error-600 dark:text-error-300"
          hx-delete="<%= update_path %>"
          hx-trigger="confirmed"
          x-data="{}"
          x-on:click.prevent="showConfirmation('<%= j(delete_confirmation) %>').then(result => { if (result.isConfirmed) { htmx.trigger($el, 'confirmed') } })"
        >Delete folder</button>
      </div>
    <% else %>
      <h2 class="text-2xl font-bold tracking-tight text-stone-800 dark:text-white/90"><%= folder.name %></h2>
    <% end %>
  </div>
  <% if error %>
    <p role="alert" class="mt-2 text-sm text-error-600 dark:text-error-300"><%= error %></p>
  <% end %>
</div>
