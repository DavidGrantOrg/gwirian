<% content_for :title, "Features - #{@project.name}" %>
<div class="<%= @folders.any? ? "max-w-6xl" : "max-w-3xl" %> mx-auto px-4 py-12">
  <!-- Header -->
  <%= render Shared::PageHeaderComponent.new(
    title: "Features",
    subtitle: "Manage features for #{@project.name}"
  ) do |c| %>
    <% if @project.editor?(Current.user) || @project.admin?(Current.user) %>
      <% c.with_actions do %>
        <%= button_to "New feature", project_features_path(@project), method: :post, class: "btn btn-primary" %>
      <% end %>
    <% end %>
  <% end %>

  <% if @folders.any? %>
    <div class="flex flex-col md:flex-row gap-8">
      <aside class="md:w-64 shrink-0">
        <%= render Folders::TreeComponent.new(project: @project, folders: @folders, selected: @folder) %>
      </aside>
      <div class="flex-1 min-w-0">
        <%= render "features/search", folder: @folder %>
        <div id="features-container">
          <% if params[:q].present? %>
            <%= render "features/search_info" %>
            <%= render partial: "features/features", locals: { features: @features, project: @project, folders_by_id: @folders.index_by(&:id) } %>
          <% else %>
            <%= render "features/folder_contents", folder: @folder, folders: @folders, features: @features, project: @project %>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <%= render "features/search", folder: nil %>
    <!-- Features List with Search Results Info -->
    <div id="features-container">
      <% if params[:q].present? %>
        <%= render "features/search_info" %>
      <% end %>
      <%= render partial: "features/features", locals: { features: @features, project: @project } %>
    </div>
  <% end %>
</div>
