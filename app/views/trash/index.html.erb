<% content_for :title, "Trash - #{@project.name}" %>

<div class="max-w-6xl mx-auto px-4 py-8">
  <%= render Shared::PageHeaderComponent.new(
    title: "Trash",
    subtitle: "Deleted features and scenarios in #{@project.name}, until they are restored or deleted forever"
  ) %>

  <% if flash[:trash_refusal].present? %>
    <p role="alert" class="mb-4 px-4 py-3 rounded-lg text-sm bg-error-50 text-error-700 dark:bg-error-900/30 dark:text-error-200">
      <%= flash[:trash_refusal] %>
    </p>
  <% end %>

  <div class="bg-white dark:bg-stone-900 rounded-xl border border-stone-200 dark:border-stone-800 overflow-hidden">
    <% if @items.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead>
            <tr class="border-b border-stone-200 dark:border-stone-800">
              <% [ "Type", "Number", "Title", "Deleted by", "Deleted at", "" ].each do |heading| %>
                <th class="px-6 py-3 text-left text-xs font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider"><%= heading %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100 dark:divide-stone-800">
            <% @items.each do |item| %>
              <tr data-trash-row="<%= item.id %>" class="hover:bg-stone-50 dark:hover:bg-stone-800/50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600 dark:text-stone-400"><%= item.item_type %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-stone-500 dark:text-stone-400"><%= item.number %></td>
                <td class="px-6 py-4 text-sm font-medium text-stone-900 dark:text-white"><%= item.title %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-600 dark:text-stone-400"><%= item.trashed_by&.email_address || "Unknown" %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-stone-500 dark:text-stone-400"><%= format_datetime(item.created_at) %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if can?(:restore, item) %>
                    <div class="flex items-center justify-end gap-2">
                      <%= button_to "Restore", restore_project_trashed_item_path(@project, item), class: "btn btn-sm btn-primary" %>
                      <%= link_to "Download snapshot", download_project_trashed_item_path(@project, item), class: "btn btn-sm btn-ghost" %>
                      <%= button_to "Delete forever", project_trashed_item_path(@project, item),
                            method: :delete,
                            "x-data": "{}",
                            "@click.prevent": "showConfirmation(#{delete_forever_message(item, trashed_scenarios: @trashed_scenario_counts.fetch(item.item_id, 0)).to_json}).then(result => { if (result.isConfirmed) $el.closest('form').submit() })",
                            class: "btn btn-sm btn-danger" %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-6 py-16 text-center text-sm text-stone-500 dark:text-stone-400">Nothing in the Trash.</p>
    <% end %>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="mt-6">
      <%= render "shared/pagination", pagy: @pagy %>
    </div>
  <% end %>
</div>
